{
  "name": "spellstorm",
  "productName": "Spellstorm",
  "version": "1.0.0",
  "description": "Spellstorm vs CPU",
  "author": "Spellstorm",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.spellstorm.game",
    "productName": "Spellstorm",
    "files": ["main.js", "icon.ico", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "icon": "icon.ico" },
    "portable": { "artifactName": "Spellstorm-${version}.exe" }
  }
}
